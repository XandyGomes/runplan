# Strava API — pode reaproveitar o mesmo Client ID/Secret de outro app seu para testar
# localmente (localhost sempre funciona, não depende do domínio configurado no app do
# Strava). Antes de ir pra produção, crie um app próprio em https://developers.strava.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Supabase (https://supabase.com) — dá pra reaproveitar um projeto Supabase que você já
# tenha (mesmo de outro app), desde que os nomes de tabela não colidam. Só rode
# supabase/schema.sql no SQL Editor desse projeto para criar profiles/plans/workouts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA para o resumo de treino (pelo menos uma das duas) — são chaves pessoais, pode
# reaproveitar as mesmas de outro projeto seu sem problema.
GEMINI_API_KEY=
GROQ_API_KEY=

# Opcional: URL pública do app em produção (usada no redirect_uri do Strava)
# NEXT_PUBLIC_APP_URL=https://seu-dominio.vercel.app

# Código secreto exigido para desbloquear o Premium sem cobrança real (tela de paywall
# e Perfil). Escolha um valor só seu — sem ele, ninguém consegue se dar acesso premium
# sozinho pela URL pública.
PREMIUM_UNLOCK_CODE=

# Opcional: ativa cobrança real de assinatura (não implementado neste MVP)
# STRIPE_SECRET_KEY=
